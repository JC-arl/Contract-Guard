# Ollama
OLLAMA_MODEL_NAME=exaone3.5:7.8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=60

# Embedding
EMBEDDING_DEVICE=auto

# ChromaDB
CHROMA_COLLECTION=contract_kb

# Detection
RULE_SCORE_THRESHOLD=0.3
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.5

# OCR (PaddleOCR) — 기본 GPU. paddlepaddle-gpu 가 설치되어 있어야 함.
# CUDA 미설치 환경에서 일시적으로 끄려면 OCR_DEVICE=cpu 로 바꾸면 use_gpu=False 로 동작.
OCR_DEVICE=gpu
# 레이아웃 분석(PP-Structure) — 제목/본문/표/그림 영역 분리. 한국어 fine-tune 부재로
# 분류 품질이 낮으면 OCR_USE_LAYOUT=false 로 끄고 raw 박스만 사용.
OCR_USE_LAYOUT=true
