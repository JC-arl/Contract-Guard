# Ollama
OLLAMA_MODEL_NAME=exaone3.5:7.8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=60

# Embedding
EMBEDDING_DEVICE=auto

# ChromaDB
CHROMA_COLLECTION=contract_kb

# Detection
RULE_SCORE_THRESHOLD=0.3
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.5

# Auth/Session — RBAC 도입 후 필수
# 시크릿 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=replace-with-generated-secret
SESSION_TTL_DAYS=14
SECURE_COOKIE=false

# 최초 Admin 계정 — 부팅 시 해당 이메일이 없으면 자동 생성 (멱등). 셋 다 채워야 시드됨.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_NAME=관리자
